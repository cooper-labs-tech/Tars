          "padding": [
            8,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "gXkSF",
              "name": "PanelCaption",
              "fill": "$text-secondary",
              "content": "PARTI PRIS",
              "lineHeight": 1.2,
