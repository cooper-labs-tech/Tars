              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "An agent’s detail is one line in 256px: its current task truncates sooner than in the 264px rail.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "K8rvK",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Past six agents, the team scrolls under the rooms in the left column.",
