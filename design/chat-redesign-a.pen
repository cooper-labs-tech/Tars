            {
              "type": "text",
              "id": "n5SFb",
              "name": "line",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A task Backend Engineer never took, because its terminal ended first, ends not delivered: Tars's note says so in the thread, the panel marks it in the error tone, and nothing is retried by itself. The orchestrator asks what to do with it.",
              "lineHeight": 1.5,
