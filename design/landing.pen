              "textGrowth": "fixed-width",
              "width": 720,
              "content": "Last updated: 2026-09-24.",
              "lineHeight": 1.7,
              "fontFamily": "$font-ui",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "kSS27",
              "name": "sp",
              "width": "fill_container",
              "height": 12
            },
            {
              "type": "text",
              "id": "G8xgj",
              "name": "p",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 720,
              "content": "This policy covers two things: the Tars desktop app, and the website that offers it for download.",
              "lineHeight": 1.7,
              "fontFamily": "$font-ui",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "sfcJj",
              "name": "sp",
              "width": "fill_container",
              "height": 36
            },
            {
              "type": "text",
              "id": "gZAPE",
              "name": "h2",
              "fill": "$text-primary",
              "content": "The short version",
              "lineHeight": 1.2,
              "fontFamily": "$font-display",
              "fontSize": 28,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "jXrAc",
              "name": "sp",
              "width": "fill_container",
              "height": 14
            },
            {
              "type": "frame",
              "id": "V8cOUJ",
              "name": "list",
              "width": 720,
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "frame",
                  "id": "rFEyS",
                  "name": "li",
                  "width": "fill_container",
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "Y03MFv",
                      "name": "bullet",
                      "padding": [
                        11,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "rectangle",
                          "id": "c8WRwt",
                          "name": "sq",
                          "fill": "$text-muted",
                          "width": 4,
                          "height": 4
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "beiSD",
                      "name": "text",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": 704,
                      "content": "Tars is a desktop app that runs on your Mac. There is no Tars server and no Tars account, and the app collects no analytics or telemetry.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "I6jMwh",
                  "name": "li",
                  "width": "fill_container",
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "w2i1RM",
                      "name": "bullet",
                      "padding": [
                        11,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "rectangle",
                          "id": "TGhhI",
                          "name": "sq",
                          "fill": "$text-muted",
                          "width": 4,
                          "height": 4
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "CRZsX",
                      "name": "text",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": 704,
                      "content": "What Tars stores, it stores in folders in your home directory, on your machine.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "I00l8",
                  "name": "li",
                  "width": "fill_container",
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "RiFr4",
                      "name": "bullet",
                      "padding": [
                        11,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "rectangle",
                          "id": "KAbLd",
                          "name": "sq",
                          "fill": "$text-muted",
                          "width": 4,
                          "height": 4
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "A8bf7",
                      "name": "text",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": 704,
                      "content": "Data leaves your machine only toward services you connect yourself: the AI providers whose command-line tools or API keys you use, and integrations such as Telegram, Slack or Discord that you turn on. Each of them receives data under its own terms, not ours.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "vlmfj",
                  "name": "li",
                  "width": "fill_container",
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
                      "id": "jfxMC",
                      "name": "bullet",
                      "padding": [
                        11,
                        0,
                        0,
                        0
                      ],
                      "children": [
                        {
                          "type": "rectangle",
                          "id": "RMG9F",
                          "name": "sq",
                          "fill": "$text-muted",
                          "width": 4,
                          "height": 4
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "p14g8",
                      "name": "text",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": 704,
                      "content": "The website uses Vercel Web Analytics, which sets no cookies, and counts downloads from GitHub's own release figures.",
                      "lineHeight": 1.7,
                      "fontFamily": "$font-ui",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "dFSfF",
              "name": "sp",
              "width": "fill_container",
              "height": 36
            },
            {
              "type": "text",
              "id": "S02jNX",
              "name": "h2",
              "fill": "$text-primary",
              "content": "Who runs what",
              "lineHeight": 1.2,
              "fontFamily": "$font-display",
              "fontSize": 28,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "ncdYT",
              "name": "sp",
              "width": "fill_container",
              "height": 14
            },
            {
              "type": "text",
              "id": "duz8a",
              "name": "p",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 720,
              "content": "Tars is open-source software published by Cooper Labs (contact@cooperlabs.xyz). When you run Tars, you run it: the app, the agents it starts and the data they handle are on your computer, under your macOS account. Nobody operating this project receives your prompts, your code, your files, your keys or your usage. We have no server that could receive them.",
              "lineHeight": 1.7,
              "fontFamily": "$font-ui",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "q4GTe",
              "name": "sp",
              "width": "fill_container",
              "height": 36
            },
            {
              "type": "text",
              "id": "jPIte",
              "name": "h2",
              "fill": "$text-primary",
              "content": "What stays on your machine",
              "lineHeight": 1.2,
              "fontFamily": "$font-display",
              "fontSize": 28,
              "fontWeight": "normal"
