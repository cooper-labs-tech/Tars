            },
            {
              "type": "text",
              "id": "axvgr",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Switching between Hermes and a room is the same gesture as switching projects on the Dashboard, and each tab says what needs you.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "wEp5v",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Every agent is visible with its task, its queue and its one action, without a click.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "aQyAe",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A message’s delivery state sits in the margin beside it, with a count on the card of the agent it waits for: two places instead of four, and the text column stays clean.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "J9IKQx",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Room state and stop sit in the room head, rules one ghost button away.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
