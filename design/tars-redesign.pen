                              "name": "h",
                              "fill": "$text-muted",
                              "textGrowth": "fixed-width",
                              "width": 380,
                              "content": "Hermes carries Tars's messages to you on every gateway it has, and brings your replies back to the agent they answer. On: Tars installs tars-relay on your Hermes, sets you on each gateway, tests each, then switches the Tars bot off. Off: it puts everything back.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-ui",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            }
