          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "vGxFO",
          "name": "rule 3",
          "fill": "#727272",
          "content": "the last 4 bars · card flush right with the bar",
          "lineHeight": 1.5,
          "fontFamily": "$font-mono",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "JUMs3",
          "name": "rule note",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The card is anchored by bar index, so it always lands inside the panel. Four bars at each end and not two: the card is 190 wide and a bar is a fourteenth of the panel, so at the narrowest two column width centring the third one already hangs it off the edge. Nothing overflows to the right, and the Usage page never scrolls sideways.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "T3sBpz",
          "name": "timeframe cap",
          "fill": "$text-muted",
          "content": "THE TIMEFRAME SETS THE BARS",
          "lineHeight": 1.6,
          "fontFamily": "$font-ui",
          "fontSize": 10,
          "fontWeight": "normal",
          "letterSpacing": 0.6
        },
        {
          "type": "text",
          "id": "FtJju",
          "name": "timeframe 14 days",
