          "children": [
            {
              "type": "text",
              "id": "Jl1HU",
              "name": "title",
              "fill": "$text-primary",
              "content": "Permissions: plan mode",
              "lineHeight": 1.1,
              "fontFamily": "$font-display",
              "fontSize": 28,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "VhOnY",
              "name": "intro",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 946,
              "content": "Plan is the narrowest mode: Claude Code reads and plans, and edits nothing until you approve its plan. It is chosen where an agent's mode is: New agent and Edit agent, and an agent's window. Only Claude Code has it here: another CLI would run plan as manual, so there plan is dimmed and says why, and choosing that CLI while plan is chosen falls back to manual.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "nNdu5",
          "name": "states",
          "width": "fill_container",
          "gap": 24,
