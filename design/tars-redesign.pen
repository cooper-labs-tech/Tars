              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
              "fontSize": 10,
              "fontWeight": "normal",
              "letterSpacing": 0.6
            },
            {
              "type": "frame",
              "id": "dMmjP",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
