    {
      "type": "frame",
      "id": "UkydU",
      "x": 3080,
      "y": 19520,
      "name": "Agent stopped · who and why",
      "theme": {
        "mode": "dark"
      },
      "width": 1440,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 18,
      "padding": 24,
      "children": [
        {
          "type": "text",
          "id": "Mk1Ec",
          "name": "t",
          "fill": "$text-primary",
          "content": "Agent stopped · who stopped it, when and why",
          "lineHeight": 1.4,
          "fontFamily": "$font-display",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "kJ1hH",
          "name": "intro",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 1100,
          "content": "A stopped agent reads stopped, a word in the idle ink, with no square and no colour of its own. One line says who stopped it, when and why, where an error gives its reason: in place of the task on its card, of the branch in its pane's header, of the path in its window, and under its name in an orchestrator's rail. The line is cut where it runs out, and the whole sentence is the title of the line and of the word. Who is you for a stop from a window, Tars for its own, or the name of the agent that asked; a stop from a window gives no reason. Starting the agent again clears all of it.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "fM3mN",
          "name": "panes",
          "width": "fill_container",
          "gap": 24,
          "children": [
            {
              "type": "frame",
              "id": "IoWwJ",
              "name": "pane wide",
              "width": 900,
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
