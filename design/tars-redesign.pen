            {
              "type": "frame",
              "id": "t3hYo9",
              "name": "what it is",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "TQGiS",
                  "name": "caption",
                  "fill": "$text-muted",
                  "content": "why",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-mono",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "xC4NH",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "With the state mod, Claude Code asks Tars before a call it would put to its dialog, and its terminal shows nothing: a panel that said only waiting would leave you looking at a quiet terminal.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "SpKIb",
                  "name": "caption",
                  "fill": "$text-muted",
                  "content": "what it shows",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-mono",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "e768tp",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The tool, then what the call acts on, as Claude Code sent it, on one line: the command, the file, the address or the search. Never a file's content: Tars is not given it.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "HCO2i",
                  "name": "caption",
                  "fill": "$text-muted",
                  "content": "the answers",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-mono",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Ymaqq",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "allow runs the call. deny refuses it, and the agent reads why if you say. ask in terminal hands it to the terminal's dialog, as before the mod. The model reads who answered: the user, in Tars.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "k3E845",
                  "name": "caption",
                  "fill": "$text-muted",
                  "content": "when it goes",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-mono",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ve31K",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "At the answer; when the turn, the session or the agent ends; and after ten minutes unanswered, when the terminal's dialog asks instead.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
