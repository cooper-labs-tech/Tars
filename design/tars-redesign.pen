            {
              "type": "text",
              "id": "f7qOD",
              "name": "caption",
              "fill": "$text-secondary",
              "content": "SHELL · CHATS · A CHAT'S ACTIONS · STATES",
              "lineHeight": 1.2,
              "fontFamily": "$font-ui",
              "fontSize": 10,
              "fontWeight": "normal",
              "letterSpacing": 0.8
            },
            {
              "type": "text",
              "id": "b0o6Z",
              "name": "line",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Pin, rename in place, snooze for an hour, until tomorrow or until Monday, settle, make it the inbox, delete. Delete asks first; a refusal from the store is shown in its own words, and the work out is named. A deletion that leaves its runner's worktree on disk, or its work on a wip/ branch, says what stays and where, above the list, until ok puts it away.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
