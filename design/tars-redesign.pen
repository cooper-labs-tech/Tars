                  "type": "text",
                  "id": "bigiB",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "At the answer; when the turn, the session or the agent ends; and after ten minutes unanswered, when the terminal's dialog asks instead.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
