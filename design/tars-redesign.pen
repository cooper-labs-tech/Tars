      "layout": "vertical",
      "gap": 14,
      "padding": 24,
      "children": [
        {
          "type": "text",
          "id": "IABmt",
          "name": "t",
          "fill": "$text-primary",
          "content": "Settings · System · folders no agent owns: listed, removed only when you say so",
          "lineHeight": 1.4,
          "fontFamily": "$font-display",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "JpTyE",
          "name": "intro",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 1100,
          "content": "The folders under a project's .worktrees that no git worktree holds: git forgot them (their .git points to a folder that is gone), or they never had one. Nothing says whether they hold work, so Tars lists them with their size and when they last changed, and never removes them on its own. One button removes them all, once it has said what goes; a folder a process works in is kept, and the list says so. Above them, the disk: what is free, and that Tars warns below 30 GB.",
          "lineHeight": 1.4,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "a0djZ0",
          "name": "col asks first: a click on remove says what goes, and nothing is removed before remove",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
