                                      "name": "h",
                                      "fill": "$text-secondary",
                                      "textGrowth": "fixed-width",
                                      "width": 560,
                                      "content": "Each account signs in through Claude Code itself, in a terminal Tars opens. Tars never sees the sign-in.",
