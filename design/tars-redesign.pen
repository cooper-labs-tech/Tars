            {
              "type": "frame",
              "id": "n7C1c",
              "name": "rules",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "text",
                  "id": "WqNU2",
                  "name": "cap",
                  "fill": "$text-muted",
                  "content": "RULES",
                  "lineHeight": 1.35,
                  "fontFamily": "$font-mono",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "P97pi",
                  "name": "p",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 520,
                  "content": "It leads an agent wherever the agent itself is the subject: its card, its panel, its window, the Chat's team and fleet, and the fields that name a new one. The name follows it, 8 apart.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "pDWTJ",
                  "name": "p",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 520,
                  "content": "Status is the word beside it, in its tone: running, waiting, error, idle. Those rows carry no status square.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "PSYkj",
                  "name": "p",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 520,
                  "content": "Provider, model and branch are plain words, mono, muted: claude · opus 5 · main. No provider colours.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "R8kZ5",
                  "name": "p",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 520,
                  "content": "No character to pick. The character stays in the agent's data; nothing draws it.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "plWBj",
                  "name": "p",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 520,
                  "content": "A menu that picks an agent as a target, the room's recipients or Add agent, keeps the 6px status square: there the state decides the pick.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
