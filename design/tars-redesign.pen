                  ]
                },
                {
                  "type": "text",
                  "id": "WlYCY",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "mcp:list (every server Tars added, with its scope and its state in each CLI), mcp:add, mcp:update, mcp:remove, mcp:retry(server, cli).",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "V6udF",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "jW6Bk",
                  "name": "dot",
                  "padding": [
                    8,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "ImcSS",
                      "name": "square",
                      "fill": "$text-muted",
                      "width": 4,
                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "Cw5q0",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A small catalogue shipped inside the app (name, command or URL, the variables and secrets it needs, one line), read offline.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "k21N0",
          "name": "Into every CLI at once",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "padding": [
            10,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "JdOUl",
              "name": "caption",
              "fill": "$text-secondary",
              "content": "INTO EVERY CLI AT ONCE",
              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
              "fontSize": 10,
              "fontWeight": "normal",
              "letterSpacing": 0.6
            },
            {
              "type": "frame",
              "id": "i9jB0E",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "EF1dc",
                  "name": "dot",
                  "padding": [
                    8,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "Q5yNz",
                      "name": "square",
                      "fill": "$text-muted",
                      "width": 4,
                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "sS9pg",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Written into each installed CLI's own configuration: Claude Code's, Codex's config.toml, Qwen Code's and Gemini CLI's settings.json, OpenCode's, Pi's, Amp's. Today Custom MCP only reads ~/.claude/mcp.json and adds nothing.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "x7WD1P",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "YoIpb",
                  "name": "dot",
                  "padding": [
                    8,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "XPrC5",
                      "name": "square",
                      "fill": "$text-muted",
                      "width": 4,
                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "RgDys",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Scope: every agent (the user's configuration), a project (the project's configuration, or each of its agents' at start), an agent (that agent's at its start).",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "OEk2d",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "YMGIt",
                  "name": "dot",
                  "padding": [
                    8,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "Q7YJ0",
                      "name": "square",
                      "fill": "$text-muted",
                      "width": 4,
                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "ZDeGm",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Agents running when a server is added load it at their next start: the window says so.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "AKNqm",
          "name": "Secrets",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "padding": [
            10,
            0,
