              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A project's page, under Projects: its chats by number with their runner's state, Main named as the project's inbox; its team with what each agent is on; its terminals; its room.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
