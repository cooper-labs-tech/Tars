                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Downloads are asked of the user in Tars's window (name, size, origin), never automatic and never accepted by an agent. An accepted one goes to ~/Downloads/Tars/<project>/, keeps the system's quarantine mark, and is never opened.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
