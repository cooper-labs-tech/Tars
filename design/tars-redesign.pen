        {
          "type": "frame",
          "id": "M3mCL",
          "x": 410,
          "y": 730,
          "name": "note",
          "width": 620,
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "L5ZAo",
              "name": "cap",
              "fill": "$text-muted",
              "content": "WHY",
              "lineHeight": 1.4,
              "fontFamily": "$font-ui",
              "fontSize": 10,
              "fontWeight": "normal",
              "letterSpacing": 0.6
            },
            {
              "type": "text",
              "id": "NYST2",
              "name": "line 1",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 620,
              "content": "A template's prompt is the new agent's first message. It used to be sent the moment you pressed Create agent, whoever wrote it, and nothing on this dialog said it would be. It is now shown whole, with the rest of what the template sets, and sent only while the switch is on.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "PC9pw",
              "name": "line 2",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": 620,
              "content": "The switch is on for a built-in template as it ships and off for any other, an edited built-in included: an imported template looks just like one you made, and an edit lives in the templates file, which any agent can write. Off, the agent is created and not started, as a template without a prompt always was, and the button says which of the two will happen: Create agent, or Create and start. A template without a prompt shows neither the prompt nor the switch.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
