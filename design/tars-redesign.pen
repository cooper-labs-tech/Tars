                {
                  "type": "text",
                  "id": "l2peX",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The tool, then what the call acts on, as Claude Code sent it, on one line: the command, the file, the address or the search. Never a file's content: Tars is not given it.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "bgleP",
                  "name": "caption",
                  "fill": "$text-muted",
                  "content": "the answers",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-mono",
                  "fontSize": 10.5,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "sNYzD",
                  "name": "note",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "allow runs the call. deny refuses it, and the agent reads why if you say. ask in terminal hands it to the terminal's dialog, as before the mod. The model reads who answered: the user, in Tars.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "R7WDw",
                  "name": "caption",
                  "fill": "$text-muted",
                  "content": "when it goes",
                  "lineHeight": 1.4,
