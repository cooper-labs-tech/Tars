                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Today the window refuses any embedded page (window-manager.ts: webviewTag false, will-attach-webview prevented), and both stay: the page is a WebContentsView the main process makes and attaches where the window asks, never a <webview> tag.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
