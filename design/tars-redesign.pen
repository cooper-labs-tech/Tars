        {
          "type": "text",
          "id": "huTd0",
          "name": "intro",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 1100,
          "content": "With several Claude accounts on, Budget & limits shows the 5 h and weekly windows of each account, in the order of Settings, under Claude and the account's name. With the option off, or a single account, Claude's two rows stay as they are. A window whose reset time has passed says reset, with an empty bar, where it kept the percentage it had until the next status line.",
          "lineHeight": 1.4,
          "fontFamily": "$font-ui",
          "fontSize": 12,
          "fontWeight": "normal"
