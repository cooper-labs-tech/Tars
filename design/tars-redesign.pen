          "fontFamily": "$font-mono",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "lLWNv",
          "name": "timeframe 12 months",
          "fill": "$text-muted",
          "content": "12 months · MONTHLY MESSAGES · 12 MONTHS · a bar a month · oct 2025 to this month",
          "lineHeight": 1.5,
          "fontFamily": "$font-mono",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "z3qSdp",
          "name": "timeframe note",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Chosen once, in the page header, for the whole page. Cost, tokens and messages are cut into the same bars, so the three charts line up, and every tile and row above them adds up over the same period. The right end of a chart names the period its last bar covers.",
          "lineHeight": 1.5,
