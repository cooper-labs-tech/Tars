            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "Fmg8U",
              "name": "caption",
              "fill": "$text-secondary",
              "content": "SHELL · CHATS · LIST, A CHAT OPEN",
              "lineHeight": 1.2,
              "fontFamily": "$font-ui",
              "fontSize": 10,
              "fontWeight": "normal",
              "letterSpacing": 0.8
            },
            {
              "type": "text",
              "id": "r51ldt",
              "name": "line",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A chat opened from the list opens on its page, drawn in chat-redesign-a.pen: a chat with a runner on its conversation, a new chat on its first message, which starts its orchestrator in a worktree of its own (Chat · chats · a new chat, its first message, where the composer under this frame's chat area is drawn). A chat's actions are on its row in the list, behind the dots that show on the row the pointer is on.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "HbZfF",
          "name": "Shell · chats · new chat, its record",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "padding": [
            8,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "hkHlo",
              "name": "caption",
              "fill": "$text-secondary",
              "content": "SHELL · CHATS · NEW CHAT, ITS RECORD",
              "lineHeight": 1.2,
              "fontFamily": "$font-ui",
              "fontSize": 10,
              "fontWeight": "normal",
              "letterSpacing": 0.8
            },
            {
              "type": "text",
              "id": "V9uyj",
              "name": "line",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "New chat makes the chat's record: the project, the current one chosen and one without an orchestrator dimmed, and a title, or New chat until its first message names it. The chat takes the project's next number.",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "zFEYR",
          "name": "Shell · chats · project page, from the records",
          "width": "fill_container",
