                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One session partition per project, never Tars's own: app:// and local-file:// are not in it. No preload, no Node, full sandbox, every permission denied, http and https only, popups and external protocols refused; other sites open in the user's browser.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
