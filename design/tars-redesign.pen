                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tars's own ports are blocked from the page: the API port, the OpenAI bridge, the Hermes tunnel, the dev renderer. Certificate errors are never waived, in any build. Devtools open on the user's request only: never from an agent, never with a remote debugging port.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
