                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "uqGGT",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Kept by Tars (in ~/.tars-private after the secrets PR) and never shown back.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "A9JCn",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "F94Dd",
                  "name": "dot",
                  "padding": [
                    8,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "AclDT",
                      "name": "square",
                      "fill": "$text-muted",
                      "width": 4,
                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "w39JPV",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Handed to the server through its environment when the CLI starts it. Claude Code passes its whole environment to its MCP servers. Codex empties it: a server gets a few base variables and its own explicit env from config.toml, nothing else (measured on 13/10). A secret reaches a Codex server only through that explicit env.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "umdIm",
              "name": "line",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "Arp6c",
                  "name": "dot",
                  "padding": [
                    8,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "h6fRYn",
                      "name": "square",
                      "fill": "$text-muted",
                      "width": 4,
                      "height": 4
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "vE61l",
                  "name": "t",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "So the Backend measures each CLI first: what reaches an MCP server it starts, and from where. The window's \"never written into a CLI's configuration\" holds only for the CLIs that measure clears.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
