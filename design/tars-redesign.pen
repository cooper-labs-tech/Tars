        {
          "type": "text",
          "id": "xnmHu",
          "name": "rule cap",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A run of replies where Hermes wrote out its own format example instead of an answer. Nothing is deleted: they stay in the conversation on disk, and the flag that spots them is worked out at read time. But a bubble that says nothing must not read as a message, so a run folds into one line that says how many there were, in the place they happened, and opens on demand.",
          "lineHeight": 1.5,
          "fontFamily": "$font-ui",
          "fontSize": 11.5,
          "fontWeight": "normal"
        },
