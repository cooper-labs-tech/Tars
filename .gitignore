# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

release/

# mcp-orchestrator
mcp-memory/node_modules
mcp-memory/dist
mcp-orchestrator/node_modules
mcp-orchestrator/dist
mcp-telegram/node_modules
mcp-telegram/dist
mcp-kanban/node_modules
mcp-kanban/dist
mcp-vault/node_modules
mcp-vault/dist
mcp-socialdata/node_modules
mcp-socialdata/dist
mcp-x/node_modules
mcp-x/dist
mcp-world/node_modules
mcp-world/dist
electron/dist

.idea

# Dorothy runtime worktrees (embedded checkouts, never commit)
.worktrees/
.claude/worktrees/
e2e/report/
test-results/
design/exports/

# claude-mem writes its activity table into a CLAUDE.md in every folder a
# session reads. Only the root CLAUDE.md is the project's; a deliberate nested
# one can still be added with `git add -f`.
/*/**/CLAUDE.md

# Python bytecode (the Hermes plugin in hermes-plugins/)
__pycache__/
