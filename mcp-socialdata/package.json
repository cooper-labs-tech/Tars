{
  "name": "mcp-socialdata",
  "version": "1.0.0",
  "description": "MCP server for Twitter/X data via SocialData API - available to all agents",
  "type": "module",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/bundle.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/bundle.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3"
  }
}
