{
  "name": "tars-memory",
  "version": "1.0.0",
  "description": "MCP server giving every CLI the same memory: project notes, session observations, Hermes, gbrain and Honcho",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "tars-memory": "./dist/bundle.js"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/bundle.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/bundle.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
