{
  "name": "tars",
  "version": "2.0.5",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:3000 && tsc -p electron/tsconfig.json && node scripts/electron-dev.mjs .",
    "electron:build": "node scripts/build-renderer.mjs && bash -c 'set -e; tsc -p electron/tsconfig.json; cd mcp-memory && npm install && npm run build && cd ..; cd mcp-orchestrator && npm install && npm run build && cd ..; cd mcp-kanban && npm install && npm run build && cd ..; cd mcp-vault && npm install && npm run build && cd ..; cd mcp-socialdata && npm install && npm run build && cd ..; cd mcp-x && npm install && npm run build && cd ..; electron-builder --mac; node scripts/prune-releases.mjs'",
    "release": "node scripts/release.mjs",
    "release:win": "node scripts/release-win.mjs",
    "electron:pack": "tsc -p electron/tsconfig.json && cd mcp-memory && npm install && npm run build && cd .. && cd mcp-orchestrator && npm install && npm run build && cd .. && cd mcp-kanban && npm install && npm run build && cd .. && cd mcp-vault && npm install && npm run build && cd .. && cd mcp-socialdata && npm install && npm run build && cd .. && cd mcp-x && npm install && npm run build && cd .. && electron-builder --dir --mac -c.productName=\"Tars Sandbox\" -c.extraMetadata.productName=\"Tars Sandbox\" -c.extraMetadata.tarsSandbox=true -c.appId=xyz.cooperlabs.tars.sandbox -c.mac.icon=build/sandbox-icon.icns && node scripts/prune-releases.mjs",
    "e2e": "playwright test",
    "e2e:auto": "node scripts/scope-checks.mjs",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:guard": "node e2e/check-coverage.mjs",
    "e2e:matrix": "node e2e/matrix.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:names": "node scripts/check-private-names.mjs",
    "sandbox": "bash scripts/sandbox.sh",
    "build:renderer": "node scripts/build-renderer.mjs",
    "lint:design": "node scripts/design-lint.mjs"
  },
  "build": {
    "appId": "xyz.cooperlabs.tars",
    "productName": "Tars",
    "publish": {
      "provider": "github",
      "owner": "cooper-labs-tech",
      "repo": "Tars"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "electron/resources/**/*",
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/@next/swc*",
      "!node_modules/@next/env",
      "skills/**/*",
      "hooks/**/*"
    ],
    "asarUnpack": [
      "out/**/*",
      "hooks/**/*",
      "electron/resources/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "mods/tars-state",
        "to": "mods/tars-state"
      },
      {
        "from": "mcp-memory",
        "to": "mcp-memory",
        "filter": [
          "package.json",
          "dist/bundle.js"
        ]
      },
      {
        "from": "mcp-orchestrator",
        "to": "mcp-orchestrator",
        "filter": [
          "package.json",
          "dist/bundle.js"
        ]
      },
      {
        "from": "mcp-kanban",
        "to": "mcp-kanban",
        "filter": [
          "package.json",
          "dist/bundle.js"
        ]
      },
      {
        "from": "mcp-vault",
        "to": "mcp-vault",
        "filter": [
          "package.json",
          "dist/bundle.js"
        ]
      },
      {
        "from": "mcp-socialdata",
        "to": "mcp-socialdata",
        "filter": [
          "package.json",
          "dist/bundle.js"
        ]
      },
      {
        "from": "mcp-x",
        "to": "mcp-x",
        "filter": [
          "package.json",
          "dist/bundle.js"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Tars",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Tars-Windows-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tars",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tars-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/electron": "7.20.0",
    "@slack/bolt": "^4.0.1",
    "better-sqlite3": "^13.0.3",
    "call-bind": "^1.0.8",
    "call-bind-apply-helpers": "^1.0.2",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.29.0",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "lucide-react": "^0.563.0",
    "next": "^16.3.2",
    "node-pty": "^1.1.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.2",
    "set-function-length": "^1.2.2",
    "smol-toml": "1.9.0",
    "uuid": "^9.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-serialize": "0.11.0",
    "xterm-headless": "5.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9.0.8",
    "concurrently": "^9.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "undici": "6.29.1",
    "vitest": "^4.1.12",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "request": {
      "form-data": "2.5.6",
      "tough-cookie": "^4.1.4"
    },
    "@cypress/request": {
      "form-data": "2.5.6",
      "tough-cookie": "^4.1.4"
    }
  }
}
